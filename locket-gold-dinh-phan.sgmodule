#!name=Locket Gold - Đình Media
#!desc=Kích hoạt Locket Gold thương hiệu Đình Media chuẩn nhất
#!author=ĐÌNH MEDIA
#!category=Locket

[Header Rewrite]
http-request ^https?:\/\/(api\.(revenuecat|rc-backup)\.com)\/.+\/(receipts|subscribers) header-del x-revenuecat-etag

[Script]
locket_revenuecat = type=http-response,pattern=^https?:\/\/(api\.(revenuecat|rc-backup)\.com)\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/haidinh11550034333-blip/dinhmedia-module/main/dinhmedia.js?v=3

locket_user = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/.+,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/haidinh11550034333-blip/dinhmedia-module/main/dinhmedia.js?v=3

[MITM]
hostname = api.revenuecat.com, api.rc-backup.com, api.locketcamera.com
